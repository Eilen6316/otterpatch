{
  "name": "@otterpatch/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "node --import tsx --test electron/ipc-contract.test.cjs src/Composer.test.tsx src/agent-client.test.ts src/app-history.test.ts src/app-proposal-flow.test.ts src/app-workspace-proposals.test.ts src/commit-client.test.ts src/docximport.test.ts src/drawio-io.test.ts src/drawio-proposal-adapter.test.ts src/drawio-review-adapter.test.ts src/excel-review-adapter.test.ts src/excel-structure-adapter.test.ts src/file-snapshot.test.ts src/proposal-materializers.test.ts src/review-policy.test.ts src/richdoc-editing.test.ts src/richdoc-projection.test.ts src/sheet-scalars.test.ts src/use-review-actions.test.ts src/use-review-state.test.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "cross-env OTTERPATCH_DEV=1 electron .",
    "app": "npm run build && electron .",
    "app:pack": "npm run build && electron-builder",
    "app:pack:dir": "npm run build && electron-builder --dir --publish never --config.win.signAndEditExecutable=false",
    "test:packaged": "node scripts/packaged-smoke.mjs"
  },
  "dependencies": {
    "@otterpatch/core": "0.0.1",
    "@otterpatch/writeback-surgical": "0.0.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "ai.otterpatch.desktop",
    "productName": "OtterPatch",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mcp-server/dist",
        "to": "serve",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "icons/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "icons/icon.png"
    }
  }
}
